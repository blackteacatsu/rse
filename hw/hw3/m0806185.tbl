CCSD3ZF0000100000001NJPL3IF0PDS200000001 = SFDU_LABEL

/* File Structure */

RECORD_TYPE = FIXED_LENGTH
RECORD_BYTES = 512
FILE_RECORDS = 85
LABEL_RECORDS = 30
FILE_STATE = CLEAN

^HISTORY = 31
OBJECT = HISTORY
END_OBJECT = HISTORY

^TABLE = 81
OBJECT = TABLE
/* Table object description */
  INTERCHANGE_FORMAT = BINARY
  OBJECT_TYPE = ISIS_TABLE
  OBJECT_DATA_TYPE = UNKNOWN
  ROWS = 76

/* Row structure */
  ROW_BYTES = 32
  COLUMNS = 4
  COLUMN_NAME = (TIME,LATITUDE,LONGITUDE,ELEVATION)

/* Column description */
  COLUMN_ITEMS = (1,1,1,1)
  COLUMN_ITEM_BYTES = (8,8,8,8)
  COLUMN_ITEM_TYPE = (PC_REAL,PC_REAL,PC_REAL,PC_REAL)
  COLUMN_ITEM_FORMAT = ("D24.15","D23.15","D23.15","D23.15")

  REAL_VALID_MINIMUM = 16#FF7FFFFA#
  REAL_NULL = 16#FF7FFFFB#
  REAL_LOW_REPR_SATURATION = 16#FF7FFFFC#
  REAL_LOW_INSTR_SATURATION = 16#FF7FFFFD#
  REAL_HIGH_INSTR_SATURATION = 16#FF7FFFFE#
  REAL_HIGH_REPR_SATURATION = 16#FF7FFFFF#

  GROUP = ISIS_TARGET
    TARGET_NAME = MARS
    LATITUDE_SYSTEM = "OGRAPHIC"
    LONGITUDE_SYSTEM = 360
    TARGDEF = "/home/marsdata/usgs/data/targets/mars.def.4"
  END_GROUP = ISIS_TARGET

  GROUP = ISIS_INSTRUMENT
    SPACECRAFT_NAME = MARS_GLOBAL_SURVEYOR
    INSTRUMENT_ID = "MOLA"
    INSTPARS = "/home/marsdata/usgs/mgsdata/mola_parameters.def.1"
  END_GROUP = ISIS_INSTRUMENT

  GROUP = ISIS_GEOMETRY
    BASE_KERNELS = ("/home/marsdata/usgs/mgsdata/naif0007.tls",
      "/home/marsdata/usgs/mgsdata/MGS_SCLKSCET.00038.tsc")
    SPACECRAFT_KERNELS = ("/home/marsdata/usgs/data/de405.bsp",
      "/home/marsdata/usgs/mgsdata/mgs_map3.bsp")
    CAMERA_KERNELS = "/home/marsdata/usgs/mgsdata/mgs_sc_map3.bc"
    CAMERA_KERNEL_TYPES = 3
    KERNLST = "/home/marsdata/usgs/mgsdata/mola_kernels.def.3"
    NAIF_SOFTWARE_VERSION = "CSPICE_N0056"
    LEV_SOFTWARE_VERSION = "MGS_MOLA_1.0"
  END_GROUP = ISIS_GEOMETRY
END_OBJECT = TABLE
END
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
